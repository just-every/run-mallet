{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node scripts/contract-docs.mjs check"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "pnpm run test:runtime"
      ]
    },
    {
      "name": "workshop-core",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-skip-pattern='(?:1440|390|^(?:GOV-004|GOV-005|GOV-006|OPS-002))' tests/mallet.test.mjs tests/demo.test.mjs"
      ]
    },
    {
      "name": "workshop-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='1440|390' --test-skip-pattern='^(?:GOV-004|GOV-005|GOV-006|OPS-002)' tests/mallet.test.mjs"
      ]
    },
    {
      "name": "sales-tax",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/sales-tax.test.mjs"
      ]
    },
    {
      "name": "pier",
      "browser": false,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/pier-journey.mjs"
      ]
    },
    {
      "name": "media",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/media.test.mjs"
      ]
    },
    {
      "name": "restore",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/restore.test.mjs"
      ]
    },
    {
      "name": "sales-report",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 tests/sales-report.test.mjs"
      ]
    },
    {
      "name": "security",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='^(?:GOV-004|GOV-005)' tests/mallet.test.mjs"
      ]
    },
    {
      "name": "retention",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='^GOV-006' tests/mallet.test.mjs"
      ]
    },
    {
      "name": "operations-core",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='^OPS-002' --test-skip-pattern='1440|390|^OPS-002: native capacity import' tests/mallet.test.mjs"
      ]
    },
    {
      "name": "operations-browser",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='^OPS-002(?: / OPS-003)?:.*(?:1440|390)' tests/mallet.test.mjs"
      ]
    },
    {
      "name": "operations-import",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test --test-concurrency=1 --test-name-pattern='^OPS-002: native capacity import' tests/mallet.test.mjs"
      ]
    }
  ],
  "nightly": [
    {
      "name": "clone-journey",
      "browser": true,
      "hosted": false,
      "commands": [
        "node tests/clone-journey.mjs"
      ]
    }
  ]
}
