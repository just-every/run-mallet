{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshop-mallet",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foundation",
      "database_id": "local-foundation-only",
      "migrations_dir": "migrations/core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INTAKE_VAULT",
      "bucket_name": "mallet-intake-vault"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "IDENTITY_PROVIDER": "",
    "PIER_ORIGIN": "",
    "MALLET_SUPPLIER_ORIGIN": ""
  }
}
